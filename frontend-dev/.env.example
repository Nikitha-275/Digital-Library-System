# Copy to .env.local for local work. Never commit real values.

# "true"  = use the built-in mock API (default, no backend needed)
# "false" = call the real backend
VITE_USE_MOCKS=true

# Base URL for API calls.
# Local dev with Vite proxy -> /api (proxied to http://localhost:8000)
# Deployed frontend         -> backend ROOT url, no /api and no trailing slash,
#                              e.g. https://your-backend.example.com
VITE_API_BASE_URL=/api
